rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'REPLACE_WITH_OWNER_EMAIL';
    }
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
  }
}